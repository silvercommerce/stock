{
    "name": "silvercommerce/stock",
    "description": "Module that adds stock control to SilverCommerce",
    "type": "silverstripe-vendormodule",
    "homepage": "http://github.com/silvercommerce/stock",
    "keywords": [
        "silverstripe",
        "silvercommerce",
        "commerce",
        "ecommerce",
        "stock",
        "stock management"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Morven Lewis-Everley",
            "email": "morven@ilateral.co.uk"
        },
        {
            "name": "Mark Anderson",
            "email": "mark@ilateral.co.uk"
        }
    ],
    "support": {
        "issues": "http://github.com/silvercommerce/stock/issues"
    },
    "require": {
        "silverstripe/framework": "^4 || ^5",
        "silvercommerce/settings": "^1",
        "silvercommerce/catalogue-admin": "^1.3",
        "silvercommerce/orders-admin": "^1.4",
        "dft/silverstripe-gridfield-addons": "^2 || ^3"
    },
    "extra": {
        "expose": [
            "client"
        ]
    },
    "autoload": {
        "psr-4": {
            "SilverCommerce\\Stock\\": "src/",
            "SilverCommerce\\Stock\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
